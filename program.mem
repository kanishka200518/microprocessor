
// Simple RISC-V Test Program
00500093 // addi x1, x0, 5      (Load 5 into x1)
00A00113 // addi x2, x0, 10     (Load 10 into x2)
002081B3 // add  x3, x1, x2     (x3 = x1 + x2 = 15)
00312023 // sw   x3, 0(x2)      (Store x3 to memory address in x2)
0000006F // jal  x0, 0          (Infinite Loop to stop PC)